{"n": 84, "ar": "الإنشقاق", "en": "Al-Inshiqaq", "place": "مكية", "bismillah": true, "verses": [{"k": "84:1", "a": 1, "t": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"}, {"k": "84:2", "a": 2, "t": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"k": "84:3", "a": 3, "t": "وَإِذَا ٱلْأَرْضُ مُدَّتْ"}, {"k": "84:4", "a": 4, "t": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"}, {"k": "84:5", "a": 5, "t": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"k": "84:6", "a": 6, "t": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"}, {"k": "84:7", "a": 7, "t": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"}, {"k": "84:8", "a": 8, "t": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"}, {"k": "84:9", "a": 9, "t": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"}, {"k": "84:10", "a": 10, "t": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"}, {"k": "84:11", "a": 11, "t": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا"}, {"k": "84:12", "a": 12, "t": "وَيَصْلَىٰ سَعِيرًا"}, {"k": "84:13", "a": 13, "t": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"}, {"k": "84:14", "a": 14, "t": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"}, {"k": "84:15", "a": 15, "t": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"}, {"k": "84:16", "a": 16, "t": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ"}, {"k": "84:17", "a": 17, "t": "وَٱلَّيْلِ وَمَا وَسَقَ"}, {"k": "84:18", "a": 18, "t": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"}, {"k": "84:19", "a": 19, "t": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"}, {"k": "84:20", "a": 20, "t": "فَمَا لَهُمْ لَا يُؤْمِنُونَ"}, {"k": "84:21", "a": 21, "t": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"}, {"k": "84:22", "a": 22, "t": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"}, {"k": "84:23", "a": 23, "t": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"}, {"k": "84:24", "a": 24, "t": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"}, {"k": "84:25", "a": 25, "t": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]}