{"n": 77, "ar": "المرسلات", "en": "Al-Mursalat", "place": "مكية", "bismillah": true, "verses": [{"k": "77:1", "a": 1, "t": "وَٱلْمُرْسَلَـٰتِ عُرْفًا"}, {"k": "77:2", "a": 2, "t": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا"}, {"k": "77:3", "a": 3, "t": "وَٱلنَّـٰشِرَٰتِ نَشْرًا"}, {"k": "77:4", "a": 4, "t": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا"}, {"k": "77:5", "a": 5, "t": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا"}, {"k": "77:6", "a": 6, "t": "عُذْرًا أَوْ نُذْرًا"}, {"k": "77:7", "a": 7, "t": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"}, {"k": "77:8", "a": 8, "t": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"}, {"k": "77:9", "a": 9, "t": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"}, {"k": "77:10", "a": 10, "t": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"}, {"k": "77:11", "a": 11, "t": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"}, {"k": "77:12", "a": 12, "t": "لِأَىِّ يَوْمٍ أُجِّلَتْ"}, {"k": "77:13", "a": 13, "t": "لِيَوْمِ ٱلْفَصْلِ"}, {"k": "77:14", "a": 14, "t": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"}, {"k": "77:15", "a": 15, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:16", "a": 16, "t": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"}, {"k": "77:17", "a": 17, "t": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"}, {"k": "77:18", "a": 18, "t": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"}, {"k": "77:19", "a": 19, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:20", "a": 20, "t": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"}, {"k": "77:21", "a": 21, "t": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ"}, {"k": "77:22", "a": 22, "t": "إِلَىٰ قَدَرٍ مَّعْلُومٍ"}, {"k": "77:23", "a": 23, "t": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"}, {"k": "77:24", "a": 24, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:25", "a": 25, "t": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"}, {"k": "77:26", "a": 26, "t": "أَحْيَآءً وَأَمْوَٰتًا"}, {"k": "77:27", "a": 27, "t": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا"}, {"k": "77:28", "a": 28, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:29", "a": 29, "t": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"k": "77:30", "a": 30, "t": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ"}, {"k": "77:31", "a": 31, "t": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"}, {"k": "77:32", "a": 32, "t": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"}, {"k": "77:33", "a": 33, "t": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ"}, {"k": "77:34", "a": 34, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:35", "a": 35, "t": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ"}, {"k": "77:36", "a": 36, "t": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"}, {"k": "77:37", "a": 37, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:38", "a": 38, "t": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"}, {"k": "77:39", "a": 39, "t": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"}, {"k": "77:40", "a": 40, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:41", "a": 41, "t": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ"}, {"k": "77:42", "a": 42, "t": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"}, {"k": "77:43", "a": 43, "t": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"}, {"k": "77:44", "a": 44, "t": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "77:45", "a": 45, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:46", "a": 46, "t": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"}, {"k": "77:47", "a": 47, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:48", "a": 48, "t": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"}, {"k": "77:49", "a": 49, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "77:50", "a": 50, "t": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]}