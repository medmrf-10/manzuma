{"n": 1, "ar": "الفاتحة", "en": "Al-Fatihah", "place": "مكية", "bismillah": false, "verses": [{"k": "1:1", "a": 1, "t": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"}, {"k": "1:2", "a": 2, "t": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}, {"k": "1:3", "a": 3, "t": "ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"}, {"k": "1:4", "a": 4, "t": "مَـٰلِكِ يَوْمِ ٱلدِّينِ"}, {"k": "1:5", "a": 5, "t": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"}, {"k": "1:6", "a": 6, "t": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"}, {"k": "1:7", "a": 7, "t": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"}]}