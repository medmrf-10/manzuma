{"n": 70, "ar": "المعارج", "en": "Al-Ma'arij", "place": "مكية", "bismillah": true, "verses": [{"k": "70:1", "a": 1, "t": "سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"}, {"k": "70:2", "a": 2, "t": "لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"}, {"k": "70:3", "a": 3, "t": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"}, {"k": "70:4", "a": 4, "t": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"}, {"k": "70:5", "a": 5, "t": "فَٱصْبِرْ صَبْرًا جَمِيلًا"}, {"k": "70:6", "a": 6, "t": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"}, {"k": "70:7", "a": 7, "t": "وَنَرَىٰهُ قَرِيبًا"}, {"k": "70:8", "a": 8, "t": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"}, {"k": "70:9", "a": 9, "t": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"}, {"k": "70:10", "a": 10, "t": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"}, {"k": "70:11", "a": 11, "t": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"}, {"k": "70:12", "a": 12, "t": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ"}, {"k": "70:13", "a": 13, "t": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"}, {"k": "70:14", "a": 14, "t": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"}, {"k": "70:15", "a": 15, "t": "كَلَّآ ۖ إِنَّهَا لَظَىٰ"}, {"k": "70:16", "a": 16, "t": "نَزَّاعَةً لِّلشَّوَىٰ"}, {"k": "70:17", "a": 17, "t": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"}, {"k": "70:18", "a": 18, "t": "وَجَمَعَ فَأَوْعَىٰٓ"}, {"k": "70:19", "a": 19, "t": "۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا"}, {"k": "70:20", "a": 20, "t": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"}, {"k": "70:21", "a": 21, "t": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"}, {"k": "70:22", "a": 22, "t": "إِلَّا ٱلْمُصَلِّينَ"}, {"k": "70:23", "a": 23, "t": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"}, {"k": "70:24", "a": 24, "t": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"}, {"k": "70:25", "a": 25, "t": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ"}, {"k": "70:26", "a": 26, "t": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"}, {"k": "70:27", "a": 27, "t": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"}, {"k": "70:28", "a": 28, "t": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"}, {"k": "70:29", "a": 29, "t": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ"}, {"k": "70:30", "a": 30, "t": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"}, {"k": "70:31", "a": 31, "t": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ"}, {"k": "70:32", "a": 32, "t": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"}, {"k": "70:33", "a": 33, "t": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ"}, {"k": "70:34", "a": 34, "t": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"}, {"k": "70:35", "a": 35, "t": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ"}, {"k": "70:36", "a": 36, "t": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"}, {"k": "70:37", "a": 37, "t": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"}, {"k": "70:38", "a": 38, "t": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"}, {"k": "70:39", "a": 39, "t": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ"}, {"k": "70:40", "a": 40, "t": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ"}, {"k": "70:41", "a": 41, "t": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"}, {"k": "70:42", "a": 42, "t": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ"}, {"k": "70:43", "a": 43, "t": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ"}, {"k": "70:44", "a": 44, "t": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ"}]}