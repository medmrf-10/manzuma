{"n": 113, "ar": "الفلق", "en": "Al-Falaq", "place": "مكية", "bismillah": true, "verses": [{"k": "113:1", "a": 1, "t": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"}, {"k": "113:2", "a": 2, "t": "مِن شَرِّ مَا خَلَقَ"}, {"k": "113:3", "a": 3, "t": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"}, {"k": "113:4", "a": 4, "t": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"}, {"k": "113:5", "a": 5, "t": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]}