{"n": 93, "ar": "الضحى", "en": "Ad-Duhaa", "place": "مكية", "bismillah": true, "verses": [{"k": "93:1", "a": 1, "t": "وَٱلضُّحَىٰ"}, {"k": "93:2", "a": 2, "t": "وَٱلَّيْلِ إِذَا سَجَىٰ"}, {"k": "93:3", "a": 3, "t": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"}, {"k": "93:4", "a": 4, "t": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"}, {"k": "93:5", "a": 5, "t": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"}, {"k": "93:6", "a": 6, "t": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"}, {"k": "93:7", "a": 7, "t": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"}, {"k": "93:8", "a": 8, "t": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"}, {"k": "93:9", "a": 9, "t": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"}, {"k": "93:10", "a": 10, "t": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"}, {"k": "93:11", "a": 11, "t": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}