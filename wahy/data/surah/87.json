{"n": 87, "ar": "الأعلى", "en": "Al-A'la", "place": "مكية", "bismillah": true, "verses": [{"k": "87:1", "a": 1, "t": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"}, {"k": "87:2", "a": 2, "t": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"}, {"k": "87:3", "a": 3, "t": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ"}, {"k": "87:4", "a": 4, "t": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"}, {"k": "87:5", "a": 5, "t": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"}, {"k": "87:6", "a": 6, "t": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"}, {"k": "87:7", "a": 7, "t": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"}, {"k": "87:8", "a": 8, "t": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"}, {"k": "87:9", "a": 9, "t": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"}, {"k": "87:10", "a": 10, "t": "سَيَذَّكَّرُ مَن يَخْشَىٰ"}, {"k": "87:11", "a": 11, "t": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى"}, {"k": "87:12", "a": 12, "t": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"}, {"k": "87:13", "a": 13, "t": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"}, {"k": "87:14", "a": 14, "t": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"}, {"k": "87:15", "a": 15, "t": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"}, {"k": "87:16", "a": 16, "t": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"}, {"k": "87:17", "a": 17, "t": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"}, {"k": "87:18", "a": 18, "t": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"}, {"k": "87:19", "a": 19, "t": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}]}