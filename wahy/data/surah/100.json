{"n": 100, "ar": "العاديات", "en": "Al-'Adiyat", "place": "مكية", "bismillah": true, "verses": [{"k": "100:1", "a": 1, "t": "وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"}, {"k": "100:2", "a": 2, "t": "فَٱلْمُورِيَـٰتِ قَدْحًا"}, {"k": "100:3", "a": 3, "t": "فَٱلْمُغِيرَٰتِ صُبْحًا"}, {"k": "100:4", "a": 4, "t": "فَأَثَرْنَ بِهِۦ نَقْعًا"}, {"k": "100:5", "a": 5, "t": "فَوَسَطْنَ بِهِۦ جَمْعًا"}, {"k": "100:6", "a": 6, "t": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"}, {"k": "100:7", "a": 7, "t": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"}, {"k": "100:8", "a": 8, "t": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"}, {"k": "100:9", "a": 9, "t": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"}, {"k": "100:10", "a": 10, "t": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ"}, {"k": "100:11", "a": 11, "t": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]}