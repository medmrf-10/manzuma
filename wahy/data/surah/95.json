{"n": 95, "ar": "التين", "en": "At-Tin", "place": "مكية", "bismillah": true, "verses": [{"k": "95:1", "a": 1, "t": "وَٱلتِّينِ وَٱلزَّيْتُونِ"}, {"k": "95:2", "a": 2, "t": "وَطُورِ سِينِينَ"}, {"k": "95:3", "a": 3, "t": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"}, {"k": "95:4", "a": 4, "t": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"}, {"k": "95:5", "a": 5, "t": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ"}, {"k": "95:6", "a": 6, "t": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}, {"k": "95:7", "a": 7, "t": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"}, {"k": "95:8", "a": 8, "t": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"}]}