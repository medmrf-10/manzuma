{"n": 89, "ar": "الفجر", "en": "Al-Fajr", "place": "مكية", "bismillah": true, "verses": [{"k": "89:1", "a": 1, "t": "وَٱلْفَجْرِ"}, {"k": "89:2", "a": 2, "t": "وَلَيَالٍ عَشْرٍ"}, {"k": "89:3", "a": 3, "t": "وَٱلشَّفْعِ وَٱلْوَتْرِ"}, {"k": "89:4", "a": 4, "t": "وَٱلَّيْلِ إِذَا يَسْرِ"}, {"k": "89:5", "a": 5, "t": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"}, {"k": "89:6", "a": 6, "t": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"}, {"k": "89:7", "a": 7, "t": "إِرَمَ ذَاتِ ٱلْعِمَادِ"}, {"k": "89:8", "a": 8, "t": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"}, {"k": "89:9", "a": 9, "t": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"}, {"k": "89:10", "a": 10, "t": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"}, {"k": "89:11", "a": 11, "t": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"}, {"k": "89:12", "a": 12, "t": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"}, {"k": "89:13", "a": 13, "t": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"}, {"k": "89:14", "a": 14, "t": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"}, {"k": "89:15", "a": 15, "t": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"}, {"k": "89:16", "a": 16, "t": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"}, {"k": "89:17", "a": 17, "t": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"}, {"k": "89:18", "a": 18, "t": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"}, {"k": "89:19", "a": 19, "t": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"}, {"k": "89:20", "a": 20, "t": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"}, {"k": "89:21", "a": 21, "t": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"}, {"k": "89:22", "a": 22, "t": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"}, {"k": "89:23", "a": 23, "t": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"}, {"k": "89:24", "a": 24, "t": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"}, {"k": "89:25", "a": 25, "t": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"}, {"k": "89:26", "a": 26, "t": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"}, {"k": "89:27", "a": 27, "t": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"}, {"k": "89:28", "a": 28, "t": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"}, {"k": "89:29", "a": 29, "t": "فَٱدْخُلِى فِى عِبَـٰدِى"}, {"k": "89:30", "a": 30, "t": "وَٱدْخُلِى جَنَّتِى"}]}