{"n": 109, "ar": "الكافرون", "en": "Al-Kafirun", "place": "مكية", "bismillah": true, "verses": [{"k": "109:1", "a": 1, "t": "قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"}, {"k": "109:2", "a": 2, "t": "لَآ أَعْبُدُ مَا تَعْبُدُونَ"}, {"k": "109:3", "a": 3, "t": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"}, {"k": "109:4", "a": 4, "t": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"}, {"k": "109:5", "a": 5, "t": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"}, {"k": "109:6", "a": 6, "t": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]}