{"n": 37, "ar": "الصافات", "en": "As-Saffat", "place": "مكية", "bismillah": true, "verses": [{"k": "37:1", "a": 1, "t": "وَٱلصَّـٰٓفَّـٰتِ صَفًّا"}, {"k": "37:2", "a": 2, "t": "فَٱلزَّٰجِرَٰتِ زَجْرًا"}, {"k": "37:3", "a": 3, "t": "فَٱلتَّـٰلِيَـٰتِ ذِكْرًا"}, {"k": "37:4", "a": 4, "t": "إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ"}, {"k": "37:5", "a": 5, "t": "رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ"}, {"k": "37:6", "a": 6, "t": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ"}, {"k": "37:7", "a": 7, "t": "وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ"}, {"k": "37:8", "a": 8, "t": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ"}, {"k": "37:9", "a": 9, "t": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ"}, {"k": "37:10", "a": 10, "t": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ"}, {"k": "37:11", "a": 11, "t": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ"}, {"k": "37:12", "a": 12, "t": "بَلْ عَجِبْتَ وَيَسْخَرُونَ"}, {"k": "37:13", "a": 13, "t": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ"}, {"k": "37:14", "a": 14, "t": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ"}, {"k": "37:15", "a": 15, "t": "وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ"}, {"k": "37:16", "a": 16, "t": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"}, {"k": "37:17", "a": 17, "t": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"}, {"k": "37:18", "a": 18, "t": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ"}, {"k": "37:19", "a": 19, "t": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ"}, {"k": "37:20", "a": 20, "t": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ"}, {"k": "37:21", "a": 21, "t": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"k": "37:22", "a": 22, "t": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ"}, {"k": "37:23", "a": 23, "t": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"}, {"k": "37:24", "a": 24, "t": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ"}, {"k": "37:25", "a": 25, "t": "مَا لَكُمْ لَا تَنَاصَرُونَ"}, {"k": "37:26", "a": 26, "t": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"}, {"k": "37:27", "a": 27, "t": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"}, {"k": "37:28", "a": 28, "t": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"}, {"k": "37:29", "a": 29, "t": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"}, {"k": "37:30", "a": 30, "t": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"}, {"k": "37:31", "a": 31, "t": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"}, {"k": "37:32", "a": 32, "t": "فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"}, {"k": "37:33", "a": 33, "t": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"}, {"k": "37:34", "a": 34, "t": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"}, {"k": "37:35", "a": 35, "t": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"}, {"k": "37:36", "a": 36, "t": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"}, {"k": "37:37", "a": 37, "t": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"}, {"k": "37:38", "a": 38, "t": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"}, {"k": "37:39", "a": 39, "t": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"}, {"k": "37:40", "a": 40, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"k": "37:41", "a": 41, "t": "أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"}, {"k": "37:42", "a": 42, "t": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"}, {"k": "37:43", "a": 43, "t": "فِى جَنَّـٰتِ ٱلنَّعِيمِ"}, {"k": "37:44", "a": 44, "t": "عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"}, {"k": "37:45", "a": 45, "t": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"}, {"k": "37:46", "a": 46, "t": "بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"}, {"k": "37:47", "a": 47, "t": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"}, {"k": "37:48", "a": 48, "t": "وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"}, {"k": "37:49", "a": 49, "t": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"}, {"k": "37:50", "a": 50, "t": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"}, {"k": "37:51", "a": 51, "t": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}, {"k": "37:52", "a": 52, "t": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"}, {"k": "37:53", "a": 53, "t": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ"}, {"k": "37:54", "a": 54, "t": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"}, {"k": "37:55", "a": 55, "t": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"}, {"k": "37:56", "a": 56, "t": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"}, {"k": "37:57", "a": 57, "t": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"}, {"k": "37:58", "a": 58, "t": "أَفَمَا نَحْنُ بِمَيِّتِينَ"}, {"k": "37:59", "a": 59, "t": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"}, {"k": "37:60", "a": 60, "t": "إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"}, {"k": "37:61", "a": 61, "t": "لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ"}, {"k": "37:62", "a": 62, "t": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"}, {"k": "37:63", "a": 63, "t": "إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ"}, {"k": "37:64", "a": 64, "t": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"}, {"k": "37:65", "a": 65, "t": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ"}, {"k": "37:66", "a": 66, "t": "فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"}, {"k": "37:67", "a": 67, "t": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"}, {"k": "37:68", "a": 68, "t": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"}, {"k": "37:69", "a": 69, "t": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"}, {"k": "37:70", "a": 70, "t": "فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ"}, {"k": "37:71", "a": 71, "t": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"}, {"k": "37:72", "a": 72, "t": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"}, {"k": "37:73", "a": 73, "t": "فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ"}, {"k": "37:74", "a": 74, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"k": "37:75", "a": 75, "t": "وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"}, {"k": "37:76", "a": 76, "t": "وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}, {"k": "37:77", "a": 77, "t": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"}, {"k": "37:78", "a": 78, "t": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"k": "37:79", "a": 79, "t": "سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ"}, {"k": "37:80", "a": 80, "t": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "37:81", "a": 81, "t": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"k": "37:82", "a": 82, "t": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"}, {"k": "37:83", "a": 83, "t": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"}, {"k": "37:84", "a": 84, "t": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"}, {"k": "37:85", "a": 85, "t": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"}, {"k": "37:86", "a": 86, "t": "أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"}, {"k": "37:87", "a": 87, "t": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ"}, {"k": "37:88", "a": 88, "t": "فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"}, {"k": "37:89", "a": 89, "t": "فَقَالَ إِنِّى سَقِيمٌ"}, {"k": "37:90", "a": 90, "t": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"}, {"k": "37:91", "a": 91, "t": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"}, {"k": "37:92", "a": 92, "t": "مَا لَكُمْ لَا تَنطِقُونَ"}, {"k": "37:93", "a": 93, "t": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"}, {"k": "37:94", "a": 94, "t": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"}, {"k": "37:95", "a": 95, "t": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"}, {"k": "37:96", "a": 96, "t": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"}, {"k": "37:97", "a": 97, "t": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"}, {"k": "37:98", "a": 98, "t": "فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ"}, {"k": "37:99", "a": 99, "t": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"}, {"k": "37:100", "a": 100, "t": "رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ"}, {"k": "37:101", "a": 101, "t": "فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ"}, {"k": "37:102", "a": 102, "t": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ"}, {"k": "37:103", "a": 103, "t": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"}, {"k": "37:104", "a": 104, "t": "وَنَـٰدَيْنَـٰهُ أَن يَـٰٓإِبْرَٰهِيمُ"}, {"k": "37:105", "a": 105, "t": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "37:106", "a": 106, "t": "إِنَّ هَـٰذَا لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ"}, {"k": "37:107", "a": 107, "t": "وَفَدَيْنَـٰهُ بِذِبْحٍ عَظِيمٍ"}, {"k": "37:108", "a": 108, "t": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"k": "37:109", "a": 109, "t": "سَلَـٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"}, {"k": "37:110", "a": 110, "t": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "37:111", "a": 111, "t": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"k": "37:112", "a": 112, "t": "وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ نَبِيًّا مِّنَ ٱلصَّـٰلِحِينَ"}, {"k": "37:113", "a": 113, "t": "وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"}, {"k": "37:114", "a": 114, "t": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"}, {"k": "37:115", "a": 115, "t": "وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}, {"k": "37:116", "a": 116, "t": "وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ"}, {"k": "37:117", "a": 117, "t": "وَءَاتَيْنَـٰهُمَا ٱلْكِتَـٰبَ ٱلْمُسْتَبِينَ"}, {"k": "37:118", "a": 118, "t": "وَهَدَيْنَـٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"}, {"k": "37:119", "a": 119, "t": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"}, {"k": "37:120", "a": 120, "t": "سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"}, {"k": "37:121", "a": 121, "t": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "37:122", "a": 122, "t": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"k": "37:123", "a": 123, "t": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"}, {"k": "37:124", "a": 124, "t": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"}, {"k": "37:125", "a": 125, "t": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ"}, {"k": "37:126", "a": 126, "t": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"}, {"k": "37:127", "a": 127, "t": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"}, {"k": "37:128", "a": 128, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"k": "37:129", "a": 129, "t": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"}, {"k": "37:130", "a": 130, "t": "سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"}, {"k": "37:131", "a": 131, "t": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"}, {"k": "37:132", "a": 132, "t": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"}, {"k": "37:133", "a": 133, "t": "وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"}, {"k": "37:134", "a": 134, "t": "إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"}, {"k": "37:135", "a": 135, "t": "إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ"}, {"k": "37:136", "a": 136, "t": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"}, {"k": "37:137", "a": 137, "t": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"}, {"k": "37:138", "a": 138, "t": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ"}, {"k": "37:139", "a": 139, "t": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"}, {"k": "37:140", "a": 140, "t": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"}, {"k": "37:141", "a": 141, "t": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"}, {"k": "37:142", "a": 142, "t": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"}, {"k": "37:143", "a": 143, "t": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"}, {"k": "37:144", "a": 144, "t": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"}, {"k": "37:145", "a": 145, "t": "۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"}, {"k": "37:146", "a": 146, "t": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"}, {"k": "37:147", "a": 147, "t": "وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"}, {"k": "37:148", "a": 148, "t": "فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ"}, {"k": "37:149", "a": 149, "t": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"}, {"k": "37:150", "a": 150, "t": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ"}, {"k": "37:151", "a": 151, "t": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"}, {"k": "37:152", "a": 152, "t": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ"}, {"k": "37:153", "a": 153, "t": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"}, {"k": "37:154", "a": 154, "t": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ"}, {"k": "37:155", "a": 155, "t": "أَفَلَا تَذَكَّرُونَ"}, {"k": "37:156", "a": 156, "t": "أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"}, {"k": "37:157", "a": 157, "t": "فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"}, {"k": "37:158", "a": 158, "t": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"}, {"k": "37:159", "a": 159, "t": "سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"}, {"k": "37:160", "a": 160, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"k": "37:161", "a": 161, "t": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ"}, {"k": "37:162", "a": 162, "t": "مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"}, {"k": "37:163", "a": 163, "t": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"}, {"k": "37:164", "a": 164, "t": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"}, {"k": "37:165", "a": 165, "t": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"}, {"k": "37:166", "a": 166, "t": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"}, {"k": "37:167", "a": 167, "t": "وَإِن كَانُوا۟ لَيَقُولُونَ"}, {"k": "37:168", "a": 168, "t": "لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"}, {"k": "37:169", "a": 169, "t": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"}, {"k": "37:170", "a": 170, "t": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"}, {"k": "37:171", "a": 171, "t": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"}, {"k": "37:172", "a": 172, "t": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"}, {"k": "37:173", "a": 173, "t": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"}, {"k": "37:174", "a": 174, "t": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"}, {"k": "37:175", "a": 175, "t": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"}, {"k": "37:176", "a": 176, "t": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"}, {"k": "37:177", "a": 177, "t": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"}, {"k": "37:178", "a": 178, "t": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"}, {"k": "37:179", "a": 179, "t": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"}, {"k": "37:180", "a": 180, "t": "سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"}, {"k": "37:181", "a": 181, "t": "وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"}, {"k": "37:182", "a": 182, "t": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}]}