{"n": 112, "ar": "الإخلاص", "en": "Al-Ikhlas", "place": "مكية", "bismillah": true, "verses": [{"k": "112:1", "a": 1, "t": "قُلْ هُوَ ٱللَّهُ أَحَدٌ"}, {"k": "112:2", "a": 2, "t": "ٱللَّهُ ٱلصَّمَدُ"}, {"k": "112:3", "a": 3, "t": "لَمْ يَلِدْ وَلَمْ يُولَدْ"}, {"k": "112:4", "a": 4, "t": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]}