{"n": 102, "ar": "التكاثر", "en": "At-Takathur", "place": "مكية", "bismillah": true, "verses": [{"k": "102:1", "a": 1, "t": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"}, {"k": "102:2", "a": 2, "t": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"}, {"k": "102:3", "a": 3, "t": "كَلَّا سَوْفَ تَعْلَمُونَ"}, {"k": "102:4", "a": 4, "t": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"}, {"k": "102:5", "a": 5, "t": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"}, {"k": "102:6", "a": 6, "t": "لَتَرَوُنَّ ٱلْجَحِيمَ"}, {"k": "102:7", "a": 7, "t": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"}, {"k": "102:8", "a": 8, "t": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]}