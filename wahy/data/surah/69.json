{"n": 69, "ar": "الحاقة", "en": "Al-Haqqah", "place": "مكية", "bismillah": true, "verses": [{"k": "69:1", "a": 1, "t": "ٱلْحَآقَّةُ"}, {"k": "69:2", "a": 2, "t": "مَا ٱلْحَآقَّةُ"}, {"k": "69:3", "a": 3, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ"}, {"k": "69:4", "a": 4, "t": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ"}, {"k": "69:5", "a": 5, "t": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ"}, {"k": "69:6", "a": 6, "t": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ"}, {"k": "69:7", "a": 7, "t": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ"}, {"k": "69:8", "a": 8, "t": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ"}, {"k": "69:9", "a": 9, "t": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ"}, {"k": "69:10", "a": 10, "t": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً"}, {"k": "69:11", "a": 11, "t": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ"}, {"k": "69:12", "a": 12, "t": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ"}, {"k": "69:13", "a": 13, "t": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ"}, {"k": "69:14", "a": 14, "t": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً"}, {"k": "69:15", "a": 15, "t": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ"}, {"k": "69:16", "a": 16, "t": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ"}, {"k": "69:17", "a": 17, "t": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ"}, {"k": "69:18", "a": 18, "t": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ"}, {"k": "69:19", "a": 19, "t": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ"}, {"k": "69:20", "a": 20, "t": "إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ"}, {"k": "69:21", "a": 21, "t": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"}, {"k": "69:22", "a": 22, "t": "فِى جَنَّةٍ عَالِيَةٍ"}, {"k": "69:23", "a": 23, "t": "قُطُوفُهَا دَانِيَةٌ"}, {"k": "69:24", "a": 24, "t": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ"}, {"k": "69:25", "a": 25, "t": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ"}, {"k": "69:26", "a": 26, "t": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ"}, {"k": "69:27", "a": 27, "t": "يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ"}, {"k": "69:28", "a": 28, "t": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ"}, {"k": "69:29", "a": 29, "t": "هَلَكَ عَنِّى سُلْطَـٰنِيَهْ"}, {"k": "69:30", "a": 30, "t": "خُذُوهُ فَغُلُّوهُ"}, {"k": "69:31", "a": 31, "t": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ"}, {"k": "69:32", "a": 32, "t": "ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ"}, {"k": "69:33", "a": 33, "t": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ"}, {"k": "69:34", "a": 34, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"}, {"k": "69:35", "a": 35, "t": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ"}, {"k": "69:36", "a": 36, "t": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"}, {"k": "69:37", "a": 37, "t": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ"}, {"k": "69:38", "a": 38, "t": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ"}, {"k": "69:39", "a": 39, "t": "وَمَا لَا تُبْصِرُونَ"}, {"k": "69:40", "a": 40, "t": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"}, {"k": "69:41", "a": 41, "t": "وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ"}, {"k": "69:42", "a": 42, "t": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ"}, {"k": "69:43", "a": 43, "t": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"}, {"k": "69:44", "a": 44, "t": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ"}, {"k": "69:45", "a": 45, "t": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ"}, {"k": "69:46", "a": 46, "t": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ"}, {"k": "69:47", "a": 47, "t": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ"}, {"k": "69:48", "a": 48, "t": "وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ"}, {"k": "69:49", "a": 49, "t": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"}, {"k": "69:50", "a": 50, "t": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ"}, {"k": "69:51", "a": 51, "t": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ"}, {"k": "69:52", "a": 52, "t": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}]}