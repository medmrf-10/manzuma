{"n": 78, "ar": "النبإ", "en": "An-Naba", "place": "مكية", "bismillah": true, "verses": [{"k": "78:1", "a": 1, "t": "عَمَّ يَتَسَآءَلُونَ"}, {"k": "78:2", "a": 2, "t": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"}, {"k": "78:3", "a": 3, "t": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"}, {"k": "78:4", "a": 4, "t": "كَلَّا سَيَعْلَمُونَ"}, {"k": "78:5", "a": 5, "t": "ثُمَّ كَلَّا سَيَعْلَمُونَ"}, {"k": "78:6", "a": 6, "t": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا"}, {"k": "78:7", "a": 7, "t": "وَٱلْجِبَالَ أَوْتَادًا"}, {"k": "78:8", "a": 8, "t": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا"}, {"k": "78:9", "a": 9, "t": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"}, {"k": "78:10", "a": 10, "t": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا"}, {"k": "78:11", "a": 11, "t": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا"}, {"k": "78:12", "a": 12, "t": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"}, {"k": "78:13", "a": 13, "t": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا"}, {"k": "78:14", "a": 14, "t": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا"}, {"k": "78:15", "a": 15, "t": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا"}, {"k": "78:16", "a": 16, "t": "وَجَنَّـٰتٍ أَلْفَافًا"}, {"k": "78:17", "a": 17, "t": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا"}, {"k": "78:18", "a": 18, "t": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا"}, {"k": "78:19", "a": 19, "t": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا"}, {"k": "78:20", "a": 20, "t": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"}, {"k": "78:21", "a": 21, "t": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"}, {"k": "78:22", "a": 22, "t": "لِّلطَّـٰغِينَ مَـَٔابًا"}, {"k": "78:23", "a": 23, "t": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا"}, {"k": "78:24", "a": 24, "t": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"}, {"k": "78:25", "a": 25, "t": "إِلَّا حَمِيمًا وَغَسَّاقًا"}, {"k": "78:26", "a": 26, "t": "جَزَآءً وِفَاقًا"}, {"k": "78:27", "a": 27, "t": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا"}, {"k": "78:28", "a": 28, "t": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا"}, {"k": "78:29", "a": 29, "t": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا"}, {"k": "78:30", "a": 30, "t": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"}, {"k": "78:31", "a": 31, "t": "إِنَّ لِلْمُتَّقِينَ مَفَازًا"}, {"k": "78:32", "a": 32, "t": "حَدَآئِقَ وَأَعْنَـٰبًا"}, {"k": "78:33", "a": 33, "t": "وَكَوَاعِبَ أَتْرَابًا"}, {"k": "78:34", "a": 34, "t": "وَكَأْسًا دِهَاقًا"}, {"k": "78:35", "a": 35, "t": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا"}, {"k": "78:36", "a": 36, "t": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا"}, {"k": "78:37", "a": 37, "t": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"}, {"k": "78:38", "a": 38, "t": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا"}, {"k": "78:39", "a": 39, "t": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"}, {"k": "78:40", "a": 40, "t": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا"}]}