{"n": 86, "ar": "الطارق", "en": "At-Tariq", "place": "مكية", "bismillah": true, "verses": [{"k": "86:1", "a": 1, "t": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"}, {"k": "86:2", "a": 2, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"}, {"k": "86:3", "a": 3, "t": "ٱلنَّجْمُ ٱلثَّاقِبُ"}, {"k": "86:4", "a": 4, "t": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"}, {"k": "86:5", "a": 5, "t": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"}, {"k": "86:6", "a": 6, "t": "خُلِقَ مِن مَّآءٍ دَافِقٍ"}, {"k": "86:7", "a": 7, "t": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"}, {"k": "86:8", "a": 8, "t": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"}, {"k": "86:9", "a": 9, "t": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"}, {"k": "86:10", "a": 10, "t": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"}, {"k": "86:11", "a": 11, "t": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"}, {"k": "86:12", "a": 12, "t": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"}, {"k": "86:13", "a": 13, "t": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ"}, {"k": "86:14", "a": 14, "t": "وَمَا هُوَ بِٱلْهَزْلِ"}, {"k": "86:15", "a": 15, "t": "إِنَّهُمْ يَكِيدُونَ كَيْدًا"}, {"k": "86:16", "a": 16, "t": "وَأَكِيدُ كَيْدًا"}, {"k": "86:17", "a": 17, "t": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]}