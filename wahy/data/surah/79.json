{"n": 79, "ar": "النازعات", "en": "An-Nazi'at", "place": "مكية", "bismillah": true, "verses": [{"k": "79:1", "a": 1, "t": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا"}, {"k": "79:2", "a": 2, "t": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا"}, {"k": "79:3", "a": 3, "t": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا"}, {"k": "79:4", "a": 4, "t": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا"}, {"k": "79:5", "a": 5, "t": "فَٱلْمُدَبِّرَٰتِ أَمْرًا"}, {"k": "79:6", "a": 6, "t": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"}, {"k": "79:7", "a": 7, "t": "تَتْبَعُهَا ٱلرَّادِفَةُ"}, {"k": "79:8", "a": 8, "t": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"}, {"k": "79:9", "a": 9, "t": "أَبْصَـٰرُهَا خَـٰشِعَةٌ"}, {"k": "79:10", "a": 10, "t": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"}, {"k": "79:11", "a": 11, "t": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً"}, {"k": "79:12", "a": 12, "t": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"}, {"k": "79:13", "a": 13, "t": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"}, {"k": "79:14", "a": 14, "t": "فَإِذَا هُم بِٱلسَّاهِرَةِ"}, {"k": "79:15", "a": 15, "t": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"}, {"k": "79:16", "a": 16, "t": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"}, {"k": "79:17", "a": 17, "t": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"}, {"k": "79:18", "a": 18, "t": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"}, {"k": "79:19", "a": 19, "t": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"}, {"k": "79:20", "a": 20, "t": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ"}, {"k": "79:21", "a": 21, "t": "فَكَذَّبَ وَعَصَىٰ"}, {"k": "79:22", "a": 22, "t": "ثُمَّ أَدْبَرَ يَسْعَىٰ"}, {"k": "79:23", "a": 23, "t": "فَحَشَرَ فَنَادَىٰ"}, {"k": "79:24", "a": 24, "t": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"}, {"k": "79:25", "a": 25, "t": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ"}, {"k": "79:26", "a": 26, "t": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ"}, {"k": "79:27", "a": 27, "t": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا"}, {"k": "79:28", "a": 28, "t": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"}, {"k": "79:29", "a": 29, "t": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"}, {"k": "79:30", "a": 30, "t": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"}, {"k": "79:31", "a": 31, "t": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"}, {"k": "79:32", "a": 32, "t": "وَٱلْجِبَالَ أَرْسَىٰهَا"}, {"k": "79:33", "a": 33, "t": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"}, {"k": "79:34", "a": 34, "t": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"}, {"k": "79:35", "a": 35, "t": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ"}, {"k": "79:36", "a": 36, "t": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"}, {"k": "79:37", "a": 37, "t": "فَأَمَّا مَن طَغَىٰ"}, {"k": "79:38", "a": 38, "t": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"}, {"k": "79:39", "a": 39, "t": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"}, {"k": "79:40", "a": 40, "t": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"}, {"k": "79:41", "a": 41, "t": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"}, {"k": "79:42", "a": 42, "t": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"}, {"k": "79:43", "a": 43, "t": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"}, {"k": "79:44", "a": 44, "t": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"}, {"k": "79:45", "a": 45, "t": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"}, {"k": "79:46", "a": 46, "t": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"}]}