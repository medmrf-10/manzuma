{"n": 85, "ar": "البروج", "en": "Al-Buruj", "place": "مكية", "bismillah": true, "verses": [{"k": "85:1", "a": 1, "t": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ"}, {"k": "85:2", "a": 2, "t": "وَٱلْيَوْمِ ٱلْمَوْعُودِ"}, {"k": "85:3", "a": 3, "t": "وَشَاهِدٍ وَمَشْهُودٍ"}, {"k": "85:4", "a": 4, "t": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ"}, {"k": "85:5", "a": 5, "t": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ"}, {"k": "85:6", "a": 6, "t": "إِذْ هُمْ عَلَيْهَا قُعُودٌ"}, {"k": "85:7", "a": 7, "t": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ"}, {"k": "85:8", "a": 8, "t": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ"}, {"k": "85:9", "a": 9, "t": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ"}, {"k": "85:10", "a": 10, "t": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ"}, {"k": "85:11", "a": 11, "t": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ"}, {"k": "85:12", "a": 12, "t": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"}, {"k": "85:13", "a": 13, "t": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ"}, {"k": "85:14", "a": 14, "t": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ"}, {"k": "85:15", "a": 15, "t": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ"}, {"k": "85:16", "a": 16, "t": "فَعَّالٌ لِّمَا يُرِيدُ"}, {"k": "85:17", "a": 17, "t": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ"}, {"k": "85:18", "a": 18, "t": "فِرْعَوْنَ وَثَمُودَ"}, {"k": "85:19", "a": 19, "t": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ"}, {"k": "85:20", "a": 20, "t": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ"}, {"k": "85:21", "a": 21, "t": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ"}, {"k": "85:22", "a": 22, "t": "فِى لَوْحٍ مَّحْفُوظٍۭ"}]}