{"n": 91, "ar": "الشمس", "en": "Ash-Shams", "place": "مكية", "bismillah": true, "verses": [{"k": "91:1", "a": 1, "t": "وَٱلشَّمْسِ وَضُحَىٰهَا"}, {"k": "91:2", "a": 2, "t": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا"}, {"k": "91:3", "a": 3, "t": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"}, {"k": "91:4", "a": 4, "t": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"}, {"k": "91:5", "a": 5, "t": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"}, {"k": "91:6", "a": 6, "t": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا"}, {"k": "91:7", "a": 7, "t": "وَنَفْسٍ وَمَا سَوَّىٰهَا"}, {"k": "91:8", "a": 8, "t": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"}, {"k": "91:9", "a": 9, "t": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا"}, {"k": "91:10", "a": 10, "t": "وَقَدْ خَابَ مَن دَسَّىٰهَا"}, {"k": "91:11", "a": 11, "t": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"}, {"k": "91:12", "a": 12, "t": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"}, {"k": "91:13", "a": 13, "t": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا"}, {"k": "91:14", "a": 14, "t": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"}, {"k": "91:15", "a": 15, "t": "وَلَا يَخَافُ عُقْبَـٰهَا"}]}