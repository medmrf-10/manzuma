{"n": 97, "ar": "القدر", "en": "Al-Qadr", "place": "مكية", "bismillah": true, "verses": [{"k": "97:1", "a": 1, "t": "إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةِ ٱلْقَدْرِ"}, {"k": "97:2", "a": 2, "t": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ"}, {"k": "97:3", "a": 3, "t": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ"}, {"k": "97:4", "a": 4, "t": "تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ"}, {"k": "97:5", "a": 5, "t": "سَلَـٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ"}]}