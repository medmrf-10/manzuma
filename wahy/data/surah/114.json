{"n": 114, "ar": "الناس", "en": "An-Nas", "place": "مكية", "bismillah": true, "verses": [{"k": "114:1", "a": 1, "t": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"}, {"k": "114:2", "a": 2, "t": "مَلِكِ ٱلنَّاسِ"}, {"k": "114:3", "a": 3, "t": "إِلَـٰهِ ٱلنَّاسِ"}, {"k": "114:4", "a": 4, "t": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"}, {"k": "114:5", "a": 5, "t": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"}, {"k": "114:6", "a": 6, "t": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}