{"n": 90, "ar": "البلد", "en": "Al-Balad", "place": "مكية", "bismillah": true, "verses": [{"k": "90:1", "a": 1, "t": "لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"}, {"k": "90:2", "a": 2, "t": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"}, {"k": "90:3", "a": 3, "t": "وَوَالِدٍ وَمَا وَلَدَ"}, {"k": "90:4", "a": 4, "t": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"}, {"k": "90:5", "a": 5, "t": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"}, {"k": "90:6", "a": 6, "t": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"}, {"k": "90:7", "a": 7, "t": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"}, {"k": "90:8", "a": 8, "t": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"}, {"k": "90:9", "a": 9, "t": "وَلِسَانًا وَشَفَتَيْنِ"}, {"k": "90:10", "a": 10, "t": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"}, {"k": "90:11", "a": 11, "t": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"}, {"k": "90:12", "a": 12, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"}, {"k": "90:13", "a": 13, "t": "فَكُّ رَقَبَةٍ"}, {"k": "90:14", "a": 14, "t": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"}, {"k": "90:15", "a": 15, "t": "يَتِيمًا ذَا مَقْرَبَةٍ"}, {"k": "90:16", "a": 16, "t": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"}, {"k": "90:17", "a": 17, "t": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"}, {"k": "90:18", "a": 18, "t": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"}, {"k": "90:19", "a": 19, "t": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"}, {"k": "90:20", "a": 20, "t": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]}