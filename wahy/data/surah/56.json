{"n": 56, "ar": "الواقعة", "en": "Al-Waqi'ah", "place": "مكية", "bismillah": true, "verses": [{"k": "56:1", "a": 1, "t": "إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"}, {"k": "56:2", "a": 2, "t": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"}, {"k": "56:3", "a": 3, "t": "خَافِضَةٌ رَّافِعَةٌ"}, {"k": "56:4", "a": 4, "t": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا"}, {"k": "56:5", "a": 5, "t": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا"}, {"k": "56:6", "a": 6, "t": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا"}, {"k": "56:7", "a": 7, "t": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً"}, {"k": "56:8", "a": 8, "t": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"}, {"k": "56:9", "a": 9, "t": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"}, {"k": "56:10", "a": 10, "t": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ"}, {"k": "56:11", "a": 11, "t": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ"}, {"k": "56:12", "a": 12, "t": "فِى جَنَّـٰتِ ٱلنَّعِيمِ"}, {"k": "56:13", "a": 13, "t": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"}, {"k": "56:14", "a": 14, "t": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ"}, {"k": "56:15", "a": 15, "t": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"}, {"k": "56:16", "a": 16, "t": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ"}, {"k": "56:17", "a": 17, "t": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ"}, {"k": "56:18", "a": 18, "t": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"}, {"k": "56:19", "a": 19, "t": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"}, {"k": "56:20", "a": 20, "t": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"}, {"k": "56:21", "a": 21, "t": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"}, {"k": "56:22", "a": 22, "t": "وَحُورٌ عِينٌ"}, {"k": "56:23", "a": 23, "t": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"}, {"k": "56:24", "a": 24, "t": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"}, {"k": "56:25", "a": 25, "t": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"}, {"k": "56:26", "a": 26, "t": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا"}, {"k": "56:27", "a": 27, "t": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ"}, {"k": "56:28", "a": 28, "t": "فِى سِدْرٍ مَّخْضُودٍ"}, {"k": "56:29", "a": 29, "t": "وَطَلْحٍ مَّنضُودٍ"}, {"k": "56:30", "a": 30, "t": "وَظِلٍّ مَّمْدُودٍ"}, {"k": "56:31", "a": 31, "t": "وَمَآءٍ مَّسْكُوبٍ"}, {"k": "56:32", "a": 32, "t": "وَفَـٰكِهَةٍ كَثِيرَةٍ"}, {"k": "56:33", "a": 33, "t": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"}, {"k": "56:34", "a": 34, "t": "وَفُرُشٍ مَّرْفُوعَةٍ"}, {"k": "56:35", "a": 35, "t": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً"}, {"k": "56:36", "a": 36, "t": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا"}, {"k": "56:37", "a": 37, "t": "عُرُبًا أَتْرَابًا"}, {"k": "56:38", "a": 38, "t": "لِّأَصْحَـٰبِ ٱلْيَمِينِ"}, {"k": "56:39", "a": 39, "t": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"}, {"k": "56:40", "a": 40, "t": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ"}, {"k": "56:41", "a": 41, "t": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ"}, {"k": "56:42", "a": 42, "t": "فِى سَمُومٍ وَحَمِيمٍ"}, {"k": "56:43", "a": 43, "t": "وَظِلٍّ مِّن يَحْمُومٍ"}, {"k": "56:44", "a": 44, "t": "لَّا بَارِدٍ وَلَا كَرِيمٍ"}, {"k": "56:45", "a": 45, "t": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"}, {"k": "56:46", "a": 46, "t": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"}, {"k": "56:47", "a": 47, "t": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"}, {"k": "56:48", "a": 48, "t": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"}, {"k": "56:49", "a": 49, "t": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ"}, {"k": "56:50", "a": 50, "t": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ"}, {"k": "56:51", "a": 51, "t": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"}, {"k": "56:52", "a": 52, "t": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"}, {"k": "56:53", "a": 53, "t": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"}, {"k": "56:54", "a": 54, "t": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"}, {"k": "56:55", "a": 55, "t": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ"}, {"k": "56:56", "a": 56, "t": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"}, {"k": "56:57", "a": 57, "t": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ"}, {"k": "56:58", "a": 58, "t": "أَفَرَءَيْتُم مَّا تُمْنُونَ"}, {"k": "56:59", "a": 59, "t": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ"}, {"k": "56:60", "a": 60, "t": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"}, {"k": "56:61", "a": 61, "t": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"}, {"k": "56:62", "a": 62, "t": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"}, {"k": "56:63", "a": 63, "t": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ"}, {"k": "56:64", "a": 64, "t": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"}, {"k": "56:65", "a": 65, "t": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ"}, {"k": "56:66", "a": 66, "t": "إِنَّا لَمُغْرَمُونَ"}, {"k": "56:67", "a": 67, "t": "بَلْ نَحْنُ مَحْرُومُونَ"}, {"k": "56:68", "a": 68, "t": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"}, {"k": "56:69", "a": 69, "t": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"}, {"k": "56:70", "a": 70, "t": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"}, {"k": "56:71", "a": 71, "t": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"}, {"k": "56:72", "a": 72, "t": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"}, {"k": "56:73", "a": 73, "t": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ"}, {"k": "56:74", "a": 74, "t": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}, {"k": "56:75", "a": 75, "t": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"}, {"k": "56:76", "a": 76, "t": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"}, {"k": "56:77", "a": 77, "t": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"}, {"k": "56:78", "a": 78, "t": "فِى كِتَـٰبٍ مَّكْنُونٍ"}, {"k": "56:79", "a": 79, "t": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"}, {"k": "56:80", "a": 80, "t": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"}, {"k": "56:81", "a": 81, "t": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"}, {"k": "56:82", "a": 82, "t": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"}, {"k": "56:83", "a": 83, "t": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"}, {"k": "56:84", "a": 84, "t": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"}, {"k": "56:85", "a": 85, "t": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"}, {"k": "56:86", "a": 86, "t": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"}, {"k": "56:87", "a": 87, "t": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"}, {"k": "56:88", "a": 88, "t": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"}, {"k": "56:89", "a": 89, "t": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"}, {"k": "56:90", "a": 90, "t": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"}, {"k": "56:91", "a": 91, "t": "فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"}, {"k": "56:92", "a": 92, "t": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"}, {"k": "56:93", "a": 93, "t": "فَنُزُلٌ مِّنْ حَمِيمٍ"}, {"k": "56:94", "a": 94, "t": "وَتَصْلِيَةُ جَحِيمٍ"}, {"k": "56:95", "a": 95, "t": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"}, {"k": "56:96", "a": 96, "t": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}]}