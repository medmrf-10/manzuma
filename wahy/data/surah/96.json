{"n": 96, "ar": "العلق", "en": "Al-'Alaq", "place": "مكية", "bismillah": true, "verses": [{"k": "96:1", "a": 1, "t": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"}, {"k": "96:2", "a": 2, "t": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"}, {"k": "96:3", "a": 3, "t": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"}, {"k": "96:4", "a": 4, "t": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"}, {"k": "96:5", "a": 5, "t": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"}, {"k": "96:6", "a": 6, "t": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"}, {"k": "96:7", "a": 7, "t": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"}, {"k": "96:8", "a": 8, "t": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"}, {"k": "96:9", "a": 9, "t": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"}, {"k": "96:10", "a": 10, "t": "عَبْدًا إِذَا صَلَّىٰٓ"}, {"k": "96:11", "a": 11, "t": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"}, {"k": "96:12", "a": 12, "t": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"}, {"k": "96:13", "a": 13, "t": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"}, {"k": "96:14", "a": 14, "t": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"}, {"k": "96:15", "a": 15, "t": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"}, {"k": "96:16", "a": 16, "t": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"}, {"k": "96:17", "a": 17, "t": "فَلْيَدْعُ نَادِيَهُۥ"}, {"k": "96:18", "a": 18, "t": "سَنَدْعُ ٱلزَّبَانِيَةَ"}, {"k": "96:19", "a": 19, "t": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}]}