{"n": 92, "ar": "الليل", "en": "Al-Layl", "place": "مكية", "bismillah": true, "verses": [{"k": "92:1", "a": 1, "t": "وَٱلَّيْلِ إِذَا يَغْشَىٰ"}, {"k": "92:2", "a": 2, "t": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"}, {"k": "92:3", "a": 3, "t": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"}, {"k": "92:4", "a": 4, "t": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ"}, {"k": "92:5", "a": 5, "t": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"}, {"k": "92:6", "a": 6, "t": "وَصَدَّقَ بِٱلْحُسْنَىٰ"}, {"k": "92:7", "a": 7, "t": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"}, {"k": "92:8", "a": 8, "t": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"}, {"k": "92:9", "a": 9, "t": "وَكَذَّبَ بِٱلْحُسْنَىٰ"}, {"k": "92:10", "a": 10, "t": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"}, {"k": "92:11", "a": 11, "t": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"}, {"k": "92:12", "a": 12, "t": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"}, {"k": "92:13", "a": 13, "t": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"}, {"k": "92:14", "a": 14, "t": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"}, {"k": "92:15", "a": 15, "t": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"}, {"k": "92:16", "a": 16, "t": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"}, {"k": "92:17", "a": 17, "t": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى"}, {"k": "92:18", "a": 18, "t": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"}, {"k": "92:19", "a": 19, "t": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"}, {"k": "92:20", "a": 20, "t": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"}, {"k": "92:21", "a": 21, "t": "وَلَسَوْفَ يَرْضَىٰ"}]}