{"n": 83, "ar": "المطففين", "en": "Al-Mutaffifin", "place": "مكية", "bismillah": true, "verses": [{"k": "83:1", "a": 1, "t": "وَيْلٌ لِّلْمُطَفِّفِينَ"}, {"k": "83:2", "a": 2, "t": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ"}, {"k": "83:3", "a": 3, "t": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"}, {"k": "83:4", "a": 4, "t": "أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"}, {"k": "83:5", "a": 5, "t": "لِيَوْمٍ عَظِيمٍ"}, {"k": "83:6", "a": 6, "t": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ"}, {"k": "83:7", "a": 7, "t": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ"}, {"k": "83:8", "a": 8, "t": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ"}, {"k": "83:9", "a": 9, "t": "كِتَـٰبٌ مَّرْقُومٌ"}, {"k": "83:10", "a": 10, "t": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}, {"k": "83:11", "a": 11, "t": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ"}, {"k": "83:12", "a": 12, "t": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ"}, {"k": "83:13", "a": 13, "t": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ"}, {"k": "83:14", "a": 14, "t": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ"}, {"k": "83:15", "a": 15, "t": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ"}, {"k": "83:16", "a": 16, "t": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ"}, {"k": "83:17", "a": 17, "t": "ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"k": "83:18", "a": 18, "t": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ"}, {"k": "83:19", "a": 19, "t": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ"}, {"k": "83:20", "a": 20, "t": "كِتَـٰبٌ مَّرْقُومٌ"}, {"k": "83:21", "a": 21, "t": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ"}, {"k": "83:22", "a": 22, "t": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"}, {"k": "83:23", "a": 23, "t": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"}, {"k": "83:24", "a": 24, "t": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ"}, {"k": "83:25", "a": 25, "t": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ"}, {"k": "83:26", "a": 26, "t": "خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ"}, {"k": "83:27", "a": 27, "t": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ"}, {"k": "83:28", "a": 28, "t": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ"}, {"k": "83:29", "a": 29, "t": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ"}, {"k": "83:30", "a": 30, "t": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ"}, {"k": "83:31", "a": 31, "t": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ"}, {"k": "83:32", "a": 32, "t": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ"}, {"k": "83:33", "a": 33, "t": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ"}, {"k": "83:34", "a": 34, "t": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ"}, {"k": "83:35", "a": 35, "t": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"}, {"k": "83:36", "a": 36, "t": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ"}]}