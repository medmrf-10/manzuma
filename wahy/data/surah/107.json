{"n": 107, "ar": "الماعون", "en": "Al-Ma'un", "place": "مكية", "bismillah": true, "verses": [{"k": "107:1", "a": 1, "t": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"}, {"k": "107:2", "a": 2, "t": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"}, {"k": "107:3", "a": 3, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"}, {"k": "107:4", "a": 4, "t": "فَوَيْلٌ لِّلْمُصَلِّينَ"}, {"k": "107:5", "a": 5, "t": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"}, {"k": "107:6", "a": 6, "t": "ٱلَّذِينَ هُمْ يُرَآءُونَ"}, {"k": "107:7", "a": 7, "t": "وَيَمْنَعُونَ ٱلْمَاعُونَ"}]}