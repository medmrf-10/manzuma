{"n": 94, "ar": "الشرح", "en": "Ash-Sharh", "place": "مكية", "bismillah": true, "verses": [{"k": "94:1", "a": 1, "t": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"}, {"k": "94:2", "a": 2, "t": "وَوَضَعْنَا عَنكَ وِزْرَكَ"}, {"k": "94:3", "a": 3, "t": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"}, {"k": "94:4", "a": 4, "t": "وَرَفَعْنَا لَكَ ذِكْرَكَ"}, {"k": "94:5", "a": 5, "t": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"}, {"k": "94:6", "a": 6, "t": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"}, {"k": "94:7", "a": 7, "t": "فَإِذَا فَرَغْتَ فَٱنصَبْ"}, {"k": "94:8", "a": 8, "t": "وَإِلَىٰ رَبِّكَ فَٱرْغَب"}]}