{"n": 55, "ar": "الرحمن", "en": "Ar-Rahman", "place": "مدنية", "bismillah": true, "verses": [{"k": "55:1", "a": 1, "t": "ٱلرَّحْمَـٰنُ"}, {"k": "55:2", "a": 2, "t": "عَلَّمَ ٱلْقُرْءَانَ"}, {"k": "55:3", "a": 3, "t": "خَلَقَ ٱلْإِنسَـٰنَ"}, {"k": "55:4", "a": 4, "t": "عَلَّمَهُ ٱلْبَيَانَ"}, {"k": "55:5", "a": 5, "t": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"}, {"k": "55:6", "a": 6, "t": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"}, {"k": "55:7", "a": 7, "t": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"}, {"k": "55:8", "a": 8, "t": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"}, {"k": "55:9", "a": 9, "t": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"}, {"k": "55:10", "a": 10, "t": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"}, {"k": "55:11", "a": 11, "t": "فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"}, {"k": "55:12", "a": 12, "t": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"}, {"k": "55:13", "a": 13, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:14", "a": 14, "t": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ"}, {"k": "55:15", "a": 15, "t": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"}, {"k": "55:16", "a": 16, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:17", "a": 17, "t": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ"}, {"k": "55:18", "a": 18, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:19", "a": 19, "t": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ"}, {"k": "55:20", "a": 20, "t": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ"}, {"k": "55:21", "a": 21, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:22", "a": 22, "t": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ"}, {"k": "55:23", "a": 23, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:24", "a": 24, "t": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ"}, {"k": "55:25", "a": 25, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:26", "a": 26, "t": "كُلُّ مَنْ عَلَيْهَا فَانٍ"}, {"k": "55:27", "a": 27, "t": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"}, {"k": "55:28", "a": 28, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:29", "a": 29, "t": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"}, {"k": "55:30", "a": 30, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:31", "a": 31, "t": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ"}, {"k": "55:32", "a": 32, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:33", "a": 33, "t": "يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ"}, {"k": "55:34", "a": 34, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:35", "a": 35, "t": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ"}, {"k": "55:36", "a": 36, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:37", "a": 37, "t": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ"}, {"k": "55:38", "a": 38, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:39", "a": 39, "t": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ"}, {"k": "55:40", "a": 40, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:41", "a": 41, "t": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"}, {"k": "55:42", "a": 42, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:43", "a": 43, "t": "هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"}, {"k": "55:44", "a": 44, "t": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"}, {"k": "55:45", "a": 45, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:46", "a": 46, "t": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"}, {"k": "55:47", "a": 47, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:48", "a": 48, "t": "ذَوَاتَآ أَفْنَانٍ"}, {"k": "55:49", "a": 49, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:50", "a": 50, "t": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ"}, {"k": "55:51", "a": 51, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:52", "a": 52, "t": "فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ"}, {"k": "55:53", "a": 53, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:54", "a": 54, "t": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"}, {"k": "55:55", "a": 55, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:56", "a": 56, "t": "فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"}, {"k": "55:57", "a": 57, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:58", "a": 58, "t": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"}, {"k": "55:59", "a": 59, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:60", "a": 60, "t": "هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ"}, {"k": "55:61", "a": 61, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:62", "a": 62, "t": "وَمِن دُونِهِمَا جَنَّتَانِ"}, {"k": "55:63", "a": 63, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:64", "a": 64, "t": "مُدْهَآمَّتَانِ"}, {"k": "55:65", "a": 65, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:66", "a": 66, "t": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"}, {"k": "55:67", "a": 67, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:68", "a": 68, "t": "فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"}, {"k": "55:69", "a": 69, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:70", "a": 70, "t": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌ"}, {"k": "55:71", "a": 71, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:72", "a": 72, "t": "حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ"}, {"k": "55:73", "a": 73, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:74", "a": 74, "t": "لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"}, {"k": "55:75", "a": 75, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:76", "a": 76, "t": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ"}, {"k": "55:77", "a": 77, "t": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"k": "55:78", "a": 78, "t": "تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"}]}