{"n": 75, "ar": "القيامة", "en": "Al-Qiyamah", "place": "مكية", "bismillah": true, "verses": [{"k": "75:1", "a": 1, "t": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"}, {"k": "75:2", "a": 2, "t": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"}, {"k": "75:3", "a": 3, "t": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"}, {"k": "75:4", "a": 4, "t": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"}, {"k": "75:5", "a": 5, "t": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"}, {"k": "75:6", "a": 6, "t": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"}, {"k": "75:7", "a": 7, "t": "فَإِذَا بَرِقَ ٱلْبَصَرُ"}, {"k": "75:8", "a": 8, "t": "وَخَسَفَ ٱلْقَمَرُ"}, {"k": "75:9", "a": 9, "t": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"}, {"k": "75:10", "a": 10, "t": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"}, {"k": "75:11", "a": 11, "t": "كَلَّا لَا وَزَرَ"}, {"k": "75:12", "a": 12, "t": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"}, {"k": "75:13", "a": 13, "t": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"}, {"k": "75:14", "a": 14, "t": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"}, {"k": "75:15", "a": 15, "t": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"}, {"k": "75:16", "a": 16, "t": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"}, {"k": "75:17", "a": 17, "t": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"}, {"k": "75:18", "a": 18, "t": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"}, {"k": "75:19", "a": 19, "t": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}, {"k": "75:20", "a": 20, "t": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"}, {"k": "75:21", "a": 21, "t": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ"}, {"k": "75:22", "a": 22, "t": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"}, {"k": "75:23", "a": 23, "t": "إِلَىٰ رَبِّهَا نَاظِرَةٌ"}, {"k": "75:24", "a": 24, "t": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"}, {"k": "75:25", "a": 25, "t": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"}, {"k": "75:26", "a": 26, "t": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"}, {"k": "75:27", "a": 27, "t": "وَقِيلَ مَنْ ۜ رَاقٍ"}, {"k": "75:28", "a": 28, "t": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"}, {"k": "75:29", "a": 29, "t": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"}, {"k": "75:30", "a": 30, "t": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"}, {"k": "75:31", "a": 31, "t": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"}, {"k": "75:32", "a": 32, "t": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"}, {"k": "75:33", "a": 33, "t": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"}, {"k": "75:34", "a": 34, "t": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"}, {"k": "75:35", "a": 35, "t": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"}, {"k": "75:36", "a": 36, "t": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"}, {"k": "75:37", "a": 37, "t": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"}, {"k": "75:38", "a": 38, "t": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"}, {"k": "75:39", "a": 39, "t": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"}, {"k": "75:40", "a": 40, "t": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]}