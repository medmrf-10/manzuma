{"n": 104, "ar": "الهمزة", "en": "Al-Humazah", "place": "مكية", "bismillah": true, "verses": [{"k": "104:1", "a": 1, "t": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"}, {"k": "104:2", "a": 2, "t": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"}, {"k": "104:3", "a": 3, "t": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"}, {"k": "104:4", "a": 4, "t": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"}, {"k": "104:5", "a": 5, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"}, {"k": "104:6", "a": 6, "t": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"}, {"k": "104:7", "a": 7, "t": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"}, {"k": "104:8", "a": 8, "t": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"}, {"k": "104:9", "a": 9, "t": "فِى عَمَدٍ مُّمَدَّدَةٍۭ"}]}