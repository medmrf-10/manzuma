{"n": 99, "ar": "الزلزلة", "en": "Az-Zalzalah", "place": "مدنية", "bismillah": true, "verses": [{"k": "99:1", "a": 1, "t": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"}, {"k": "99:2", "a": 2, "t": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"}, {"k": "99:3", "a": 3, "t": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"}, {"k": "99:4", "a": 4, "t": "يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"}, {"k": "99:5", "a": 5, "t": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"}, {"k": "99:6", "a": 6, "t": "يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"}, {"k": "99:7", "a": 7, "t": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"}, {"k": "99:8", "a": 8, "t": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"}]}