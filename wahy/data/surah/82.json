{"n": 82, "ar": "الإنفطار", "en": "Al-Infitar", "place": "مكية", "bismillah": true, "verses": [{"k": "82:1", "a": 1, "t": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"}, {"k": "82:2", "a": 2, "t": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"}, {"k": "82:3", "a": 3, "t": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"}, {"k": "82:4", "a": 4, "t": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"}, {"k": "82:5", "a": 5, "t": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"}, {"k": "82:6", "a": 6, "t": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"}, {"k": "82:7", "a": 7, "t": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"}, {"k": "82:8", "a": 8, "t": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"}, {"k": "82:9", "a": 9, "t": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"}, {"k": "82:10", "a": 10, "t": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ"}, {"k": "82:11", "a": 11, "t": "كِرَامًا كَـٰتِبِينَ"}, {"k": "82:12", "a": 12, "t": "يَعْلَمُونَ مَا تَفْعَلُونَ"}, {"k": "82:13", "a": 13, "t": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"}, {"k": "82:14", "a": 14, "t": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"}, {"k": "82:15", "a": 15, "t": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"}, {"k": "82:16", "a": 16, "t": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"}, {"k": "82:17", "a": 17, "t": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"}, {"k": "82:18", "a": 18, "t": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"}, {"k": "82:19", "a": 19, "t": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"}]}