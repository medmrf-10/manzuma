{"n": 80, "ar": "عبس", "en": "'Abasa", "place": "مكية", "bismillah": true, "verses": [{"k": "80:1", "a": 1, "t": "عَبَسَ وَتَوَلَّىٰٓ"}, {"k": "80:2", "a": 2, "t": "أَن جَآءَهُ ٱلْأَعْمَىٰ"}, {"k": "80:3", "a": 3, "t": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"}, {"k": "80:4", "a": 4, "t": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"}, {"k": "80:5", "a": 5, "t": "أَمَّا مَنِ ٱسْتَغْنَىٰ"}, {"k": "80:6", "a": 6, "t": "فَأَنتَ لَهُۥ تَصَدَّىٰ"}, {"k": "80:7", "a": 7, "t": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"}, {"k": "80:8", "a": 8, "t": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"}, {"k": "80:9", "a": 9, "t": "وَهُوَ يَخْشَىٰ"}, {"k": "80:10", "a": 10, "t": "فَأَنتَ عَنْهُ تَلَهَّىٰ"}, {"k": "80:11", "a": 11, "t": "كَلَّآ إِنَّهَا تَذْكِرَةٌ"}, {"k": "80:12", "a": 12, "t": "فَمَن شَآءَ ذَكَرَهُۥ"}, {"k": "80:13", "a": 13, "t": "فِى صُحُفٍ مُّكَرَّمَةٍ"}, {"k": "80:14", "a": 14, "t": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"}, {"k": "80:15", "a": 15, "t": "بِأَيْدِى سَفَرَةٍ"}, {"k": "80:16", "a": 16, "t": "كِرَامٍۭ بَرَرَةٍ"}, {"k": "80:17", "a": 17, "t": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ"}, {"k": "80:18", "a": 18, "t": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"}, {"k": "80:19", "a": 19, "t": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"}, {"k": "80:20", "a": 20, "t": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"}, {"k": "80:21", "a": 21, "t": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"}, {"k": "80:22", "a": 22, "t": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"}, {"k": "80:23", "a": 23, "t": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"}, {"k": "80:24", "a": 24, "t": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ"}, {"k": "80:25", "a": 25, "t": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"}, {"k": "80:26", "a": 26, "t": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"}, {"k": "80:27", "a": 27, "t": "فَأَنۢبَتْنَا فِيهَا حَبًّا"}, {"k": "80:28", "a": 28, "t": "وَعِنَبًا وَقَضْبًا"}, {"k": "80:29", "a": 29, "t": "وَزَيْتُونًا وَنَخْلًا"}, {"k": "80:30", "a": 30, "t": "وَحَدَآئِقَ غُلْبًا"}, {"k": "80:31", "a": 31, "t": "وَفَـٰكِهَةً وَأَبًّا"}, {"k": "80:32", "a": 32, "t": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"}, {"k": "80:33", "a": 33, "t": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"}, {"k": "80:34", "a": 34, "t": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"}, {"k": "80:35", "a": 35, "t": "وَأُمِّهِۦ وَأَبِيهِ"}, {"k": "80:36", "a": 36, "t": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ"}, {"k": "80:37", "a": 37, "t": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"}, {"k": "80:38", "a": 38, "t": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"}, {"k": "80:39", "a": 39, "t": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"}, {"k": "80:40", "a": 40, "t": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"}, {"k": "80:41", "a": 41, "t": "تَرْهَقُهَا قَتَرَةٌ"}, {"k": "80:42", "a": 42, "t": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"}]}