{"n": 101, "ar": "القارعة", "en": "Al-Qari'ah", "place": "مكية", "bismillah": true, "verses": [{"k": "101:1", "a": 1, "t": "ٱلْقَارِعَةُ"}, {"k": "101:2", "a": 2, "t": "مَا ٱلْقَارِعَةُ"}, {"k": "101:3", "a": 3, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"}, {"k": "101:4", "a": 4, "t": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"}, {"k": "101:5", "a": 5, "t": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"}, {"k": "101:6", "a": 6, "t": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"}, {"k": "101:7", "a": 7, "t": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"}, {"k": "101:8", "a": 8, "t": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"}, {"k": "101:9", "a": 9, "t": "فَأُمُّهُۥ هَاوِيَةٌ"}, {"k": "101:10", "a": 10, "t": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ"}, {"k": "101:11", "a": 11, "t": "نَارٌ حَامِيَةٌۢ"}]}