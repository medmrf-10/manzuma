{"n": 111, "ar": "المسد", "en": "Al-Masad", "place": "مكية", "bismillah": true, "verses": [{"k": "111:1", "a": 1, "t": "تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"}, {"k": "111:2", "a": 2, "t": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"}, {"k": "111:3", "a": 3, "t": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"}, {"k": "111:4", "a": 4, "t": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"}, {"k": "111:5", "a": 5, "t": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"}]}