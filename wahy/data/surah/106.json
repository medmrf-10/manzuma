{"n": 106, "ar": "قريش", "en": "Quraysh", "place": "مكية", "bismillah": true, "verses": [{"k": "106:1", "a": 1, "t": "لِإِيلَـٰفِ قُرَيْشٍ"}, {"k": "106:2", "a": 2, "t": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"}, {"k": "106:3", "a": 3, "t": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"}, {"k": "106:4", "a": 4, "t": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"}]}