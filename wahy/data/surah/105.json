{"n": 105, "ar": "الفيل", "en": "Al-Fil", "place": "مكية", "bismillah": true, "verses": [{"k": "105:1", "a": 1, "t": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"}, {"k": "105:2", "a": 2, "t": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"}, {"k": "105:3", "a": 3, "t": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"}, {"k": "105:4", "a": 4, "t": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"}, {"k": "105:5", "a": 5, "t": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]}