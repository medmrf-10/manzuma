{"n": 81, "ar": "التكوير", "en": "At-Takwir", "place": "مكية", "bismillah": true, "verses": [{"k": "81:1", "a": 1, "t": "إِذَا ٱلشَّمْسُ كُوِّرَتْ"}, {"k": "81:2", "a": 2, "t": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"}, {"k": "81:3", "a": 3, "t": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"}, {"k": "81:4", "a": 4, "t": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"}, {"k": "81:5", "a": 5, "t": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"}, {"k": "81:6", "a": 6, "t": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"}, {"k": "81:7", "a": 7, "t": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"}, {"k": "81:8", "a": 8, "t": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"}, {"k": "81:9", "a": 9, "t": "بِأَىِّ ذَنۢبٍ قُتِلَتْ"}, {"k": "81:10", "a": 10, "t": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ"}, {"k": "81:11", "a": 11, "t": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"}, {"k": "81:12", "a": 12, "t": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"}, {"k": "81:13", "a": 13, "t": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"}, {"k": "81:14", "a": 14, "t": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"}, {"k": "81:15", "a": 15, "t": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"}, {"k": "81:16", "a": 16, "t": "ٱلْجَوَارِ ٱلْكُنَّسِ"}, {"k": "81:17", "a": 17, "t": "وَٱلَّيْلِ إِذَا عَسْعَسَ"}, {"k": "81:18", "a": 18, "t": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ"}, {"k": "81:19", "a": 19, "t": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"}, {"k": "81:20", "a": 20, "t": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"}, {"k": "81:21", "a": 21, "t": "مُّطَاعٍ ثَمَّ أَمِينٍ"}, {"k": "81:22", "a": 22, "t": "وَمَا صَاحِبُكُم بِمَجْنُونٍ"}, {"k": "81:23", "a": 23, "t": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"}, {"k": "81:24", "a": 24, "t": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"}, {"k": "81:25", "a": 25, "t": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"}, {"k": "81:26", "a": 26, "t": "فَأَيْنَ تَذْهَبُونَ"}, {"k": "81:27", "a": 27, "t": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"}, {"k": "81:28", "a": 28, "t": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"}, {"k": "81:29", "a": 29, "t": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}]}