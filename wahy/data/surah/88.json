{"n": 88, "ar": "الغاشية", "en": "Al-Ghashiyah", "place": "مكية", "bismillah": true, "verses": [{"k": "88:1", "a": 1, "t": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ"}, {"k": "88:2", "a": 2, "t": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ"}, {"k": "88:3", "a": 3, "t": "عَامِلَةٌ نَّاصِبَةٌ"}, {"k": "88:4", "a": 4, "t": "تَصْلَىٰ نَارًا حَامِيَةً"}, {"k": "88:5", "a": 5, "t": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"}, {"k": "88:6", "a": 6, "t": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"}, {"k": "88:7", "a": 7, "t": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"}, {"k": "88:8", "a": 8, "t": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"}, {"k": "88:9", "a": 9, "t": "لِّسَعْيِهَا رَاضِيَةٌ"}, {"k": "88:10", "a": 10, "t": "فِى جَنَّةٍ عَالِيَةٍ"}, {"k": "88:11", "a": 11, "t": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً"}, {"k": "88:12", "a": 12, "t": "فِيهَا عَيْنٌ جَارِيَةٌ"}, {"k": "88:13", "a": 13, "t": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ"}, {"k": "88:14", "a": 14, "t": "وَأَكْوَابٌ مَّوْضُوعَةٌ"}, {"k": "88:15", "a": 15, "t": "وَنَمَارِقُ مَصْفُوفَةٌ"}, {"k": "88:16", "a": 16, "t": "وَزَرَابِىُّ مَبْثُوثَةٌ"}, {"k": "88:17", "a": 17, "t": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"}, {"k": "88:18", "a": 18, "t": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"}, {"k": "88:19", "a": 19, "t": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"}, {"k": "88:20", "a": 20, "t": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"}, {"k": "88:21", "a": 21, "t": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"}, {"k": "88:22", "a": 22, "t": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"}, {"k": "88:23", "a": 23, "t": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"}, {"k": "88:24", "a": 24, "t": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"}, {"k": "88:25", "a": 25, "t": "إِنَّ إِلَيْنَآ إِيَابَهُمْ"}, {"k": "88:26", "a": 26, "t": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]}